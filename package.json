{
  "name": "dsh-veryim",
  "version": "0829-0.2.1",
  "description": "\u5373\u65f6\u901a\u8baf\u6e20\u9053\u63d2\u4ef6\u2014\u2014\u628a Telegram \u7b49 IM \u63a5\u5165 DSH",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "slots",
        "remote",
        "settings"
      ]
    }
  },
  "scripts": {
    "build:server": "cd src && tsc --noEmitOnError false --outDir ../lib --target ES2022 --module ESNext --moduleResolution bundler --declaration false --esModuleInterop true --skipLibCheck true",
    "build:client": "npx tsdown",
    "build": "npm run build:server && npm run build:client"
  },
  "files": [
    "lib",
    "src",
    "cordis.patch.yml"
  ],
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "devDependencies": {
    "tsdown": "^0.22.14",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "undici": "^8.10.0"
  }
}